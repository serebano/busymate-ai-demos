{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "bmai/assistant",
  "title": "Busymate AI trigger",
  "category": "widgets",
  "description": "A button that opens your mate — the connected Busymate AI assistant — with an optional starting question.",
  "keywords": ["ai", "chat", "assistant", "support", "busymate"],
  "textdomain": "bmai-assistant",
  "attributes": {
    "label": {
      "type": "string",
      "default": "Ask us about this"
    },
    "prompt": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": ["left", "center", "right"]
  },
  "editorScript": "file:./index.js",
  "style": "file:./style.css"
}
